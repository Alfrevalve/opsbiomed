APP_NAME="OPS BIOMED MR8"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ops-biomed.test
APP_TIMEZONE=America/Lima

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ops_biomed
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Solo para seeders locales. No usar en produccion.
INITIAL_ADMIN_PASSWORD=
PILOT_DEMO_PASSWORD=

OPS_MIN_SURGERIES=3
OPS_TARGET_SURGERIES=5
OPS_YSAN_LEAD_TIME_HOURS=48
